<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: the system splash shows the icon on deep navy, then hands over to the app. -->
    <style name="Theme.QRMax.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E1626</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.QRMax</item>
    </style>
    <style name="Theme.QRMax" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
